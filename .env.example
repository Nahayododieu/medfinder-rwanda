# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_DEBUG=True
# Required when DJANGO_DEBUG=False. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Dev only: extra hosts such as an ngrok tunnel for the Africa's Talking simulator
DJANGO_EXTRA_DEV_HOSTS=
# Production database (leave empty for SQLite)
DATABASE_URL=

# Set true only after confirming HTTPS works on every subdomain
DJANGO_HSTS_PRELOAD=False

# --- Email (pharmacy password resets). Empty EMAIL_HOST = print emails to the console ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MedFinder Rwanda <no-reply@medfinder.rw>

# --- Business rules ---
RESERVATION_HOLD_HOURS=2
LOW_STOCK_THRESHOLD=5
PLATFORM_COMMISSION_RATE=0.03

# --- Africa's Talking (SMS + USSD) ---
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_CALLBACK_TOKEN=
USSD_CODE=*384*123#

# --- MTN MoMo Collections (leave empty for simulation mode) ---
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=EUR
MOMO_CALLBACK_URL=

# --- Business identity shown on the website ---
BUSINESS_NAME=MedFinder Rwanda
BUSINESS_OWNER=
BUSINESS_RDB_NUMBER=
SUPPORT_PHONE=
SUPPORT_EMAIL=
FREE_TRIAL_DAYS=30
SUBSCRIPTION_PRICE_RWF=5000

# --- Pharmacy subscriptions ---
SUBSCRIPTION_GRACE_DAYS=7
HIDE_UNPAID_PHARMACIES=True

# --- Contact and brand ---
BUSINESS_FOUNDER=
SUPPORT_WHATSAPP=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_X=
SOCIAL_LINKEDIN=

# --- Stock, reservations, security ---
EXPIRY_ALERT_DAYS=60
RESERVATION_REMINDER_MINUTES=30
PHARMACY_LOGIN_2FA=False

# --- Airtel Money (Airtel Africa Open API). Empty = simulation mode ---
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# --- Files, backups, monitoring ---
MEDIA_ROOT=
BACKUP_DIR=
BACKUP_KEEP=14
SENTRY_DSN=
